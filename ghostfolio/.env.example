# Point Compose at a user-ACL-protected file outside Git, for example:
# $env:DCA_GHOSTFOLIO_SECRETS_FILE="$env:LOCALAPPDATA\dca-ghostfolio\secrets.env"
POSTGRES_PASSWORD=generated-outside-git
REDIS_PASSWORD=generated-outside-git
ACCESS_TOKEN_SALT=generated-outside-git
JWT_SECRET_KEY=generated-outside-git
GIST_ID=private-portfolio-ledger-gist-id
GIST_TOKEN=github-token-with-gist-scope
GHOSTFOLIO_SECURITY_TOKEN=create-in-local-ghostfolio-ui
GHOSTFOLIO_ACCOUNT_MAP={"BTC_GBP":"local-account-uuid","HYPE_USD":"local-account-uuid","SOL_GBP":"local-account-uuid"}
