# Point Compose at a user-ACL-protected file outside Git, for example:
# $env:DCA_GHOSTFOLIO_SECRETS_FILE="$env:LOCALAPPDATA\dca-ghostfolio\secrets.env"
# Repository identity and every artifact path are mandatory runtime settings;
# the sidecar has no public or Gist fallback. The token needs repository
# metadata read plus Contents read/write access. Before an existing deployment
# switches, copy all three receipt ledgers byte-for-byte to the configured
# private-repository paths so delivery and reconciliation history is retained.
POSTGRES_PASSWORD=generated-outside-git
REDIS_PASSWORD=generated-outside-git
ACCESS_TOKEN_SALT=generated-outside-git
JWT_SECRET_KEY=generated-outside-git
DCA_OUTBOX_REPOSITORY_OWNER=private-repository-owner
DCA_OUTBOX_REPOSITORY_NAME=private-repository-name
DCA_OUTBOX_REPOSITORY_BRANCH=main
DCA_OUTBOX_REPOSITORY_TOKEN=fine-grained-token-with-private-repository-contents-access
DCA_OUTBOX_EVENT_PATH=portfolio/kraken_usd_dca_ghostfolio_events.jsonl
DCA_OUTBOX_HOLDINGS_PATH=portfolio/kraken_holdings_snapshot_v1.json
DCA_OUTBOX_GHOSTFOLIO_EVENT_RECEIPT_PATH=portfolio/ghostfolio_sync_receipts.jsonl
DCA_OUTBOX_GHOSTFOLIO_HOLDINGS_RECEIPT_PATH=portfolio/ghostfolio_holdings_receipts.jsonl
DCA_OUTBOX_GHOSTFOLIO_PROVENANCE_RECEIPT_PATH=portfolio/ghostfolio_provenance_reclassification_receipts.jsonl
DCA_OUTBOX_OPENING_BASIS_SOURCE_PATH=portfolio/kraken_opening_basis_source_v1.json
DCA_OUTBOX_OPENING_BASIS_PATH=portfolio/kraken_opening_basis_v1.json
DCA_OUTBOX_ACCOUNT_ACTIVITY_SOURCE_PATH=portfolio/kraken_account_activity_source_v1.json
DCA_OUTBOX_ACCOUNT_RECOVERY_PATH=portfolio/kraken_account_recovery_v1.json
GHOSTFOLIO_SECURITY_TOKEN=create-in-local-ghostfolio-ui
GHOSTFOLIO_ACCOUNT_MAP={"BTC_GBP":"local-account-uuid","HYPE_USD":"local-account-uuid","ETH_GBP":"local-account-uuid","SOL_GBP":"local-account-uuid"}
# Optional, temporary, and private: copy the exact recovery evidence into the
# user-ACL secret store only while an unreceipted allowlisted event is pending.
GHOSTFOLIO_RECOVERY_CRYPTO_ORDER_ID=temporary-private-order-id
GHOSTFOLIO_RECOVERY_FUNDING_ORDER_ID=temporary-private-order-id
GHOSTFOLIO_RECOVERY_EVENT_HASH=temporary-private-canonical-event-hash
